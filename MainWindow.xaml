<Window x:Class="DocsSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Docs Sync" Width="980" Height="640" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource Ui}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Grid.Row="0" Margin="16,0,8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Accent}">
          <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentFg}" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock Text="Docs Sync" FontFamily="{StaticResource Display}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Rescan now" Click="Refresh_Click"/>
        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
        <Rectangle Width="1" Height="16" Fill="{StaticResource Line}" Margin="6,0"/>
        <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="Min_Click"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close to tray" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" x:Name="MainView">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Note list -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
        <DockPanel Margin="12,12,6,12">
          <Border DockPanel.Dock="Top" Background="{StaticResource Bg}" CornerRadius="7" Padding="3" Margin="0,0,6,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TabStale" Style="{StaticResource Seg}" GroupName="f" IsChecked="True" Checked="Tab_Changed">Needs update</RadioButton>
              <RadioButton x:Name="TabAll" Style="{StaticResource Seg}" GroupName="f" Checked="Tab_Changed">All</RadioButton>
              <RadioButton x:Name="TabNone" Style="{StaticResource Seg}" GroupName="f" Checked="Tab_Changed">No match</RadioButton>
            </StackPanel>
          </Border>
          <Border x:Name="BatchBar" DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,6,0" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
              <Grid x:Name="BatchBusy" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform x:Name="BatchSpinnerTurn"/></TextBlock.RenderTransform>
                  </TextBlock>
                  <TextBlock x:Name="BatchBusyText" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource Btn}" Tag="&#xE711;" Content="Cancel" Click="ClaudeCancel_Click" HorizontalAlignment="Right" Padding="10,5"/>
              </Grid>
              <Button x:Name="UpdateAllButton" Style="{StaticResource Btn}" Tag="&#xE945;" Content="Update all with Claude" Click="UpdateAll_Click"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Visibility="Collapsed"/>
              <Grid x:Name="SaveAllRow" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveAllButton" Style="{StaticResource PrimaryBtn}" Tag="&#xE74E;" Content="Save all updates" Click="SaveAll_Click"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Discard all updates" Click="DiscardAll_Click" Margin="6,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>
          <Grid>
            <ListBox x:Name="NoteList" Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                     ItemContainerStyle="{StaticResource Row}" SelectionChanged="NoteList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="18"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left">
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Stale}" Visibility="{Binding IsStale, Converter={StaticResource Vis}}"/>
                      <Ellipse Width="7" Height="7" Fill="{StaticResource Ok}" Visibility="{Binding IsOk, Converter={StaticResource Vis}}"/>
                      <Ellipse Width="7" Height="7" Stroke="{StaticResource Faint}" StrokeThickness="1.2" Visibility="{Binding IsUnmatched, Converter={StaticResource Vis}}"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Project, Mode=OneWay}"/><Run Text="  ·  " Foreground="{StaticResource Faint}"/><Run Text="{Binding Summary, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,2,0,0" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding ListTime}" Foreground="{StaticResource Faint}" FontSize="11.5" HorizontalAlignment="Right"/>
                      <Border x:Name="badge" CornerRadius="8" Padding="7,1" Margin="0,4,0,0" Background="{StaticResource Hover}" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ClaudeBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ClaudeBadge}" Value="">
                      <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="ListEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed">
              <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Ok}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ListEmptyText" Text="All docs match the code" Foreground="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Detail -->
      <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
        <Grid>
          <ScrollViewer x:Name="Detail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="36,28,36,36" MaxWidth="720" HorizontalAlignment="Left">
              <TextBlock Text="{Binding Project}" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,6" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal">
                <Border CornerRadius="10" Padding="9,2" Background="#2A2218" Visibility="{Binding IsStale, Converter={StaticResource Vis}}">
                  <TextBlock Text="Needs update" Foreground="{StaticResource Stale}" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="10" Padding="9,2" Background="#17271E" Visibility="{Binding IsOk, Converter={StaticResource Vis}}">
                  <TextBlock Text="Up to date" Foreground="{StaticResource Ok}" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border CornerRadius="10" Padding="9,2" Background="{StaticResource Raised}" Visibility="{Binding IsUnmatched, Converter={StaticResource Vis}}">
                  <TextBlock Text="No code matched" Foreground="{StaticResource Muted}" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="{Binding NoteEdited}" Foreground="{StaticResource Faint}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
              </StackPanel>

              <WrapPanel Margin="0,20,0,0">
                <Button Style="{StaticResource PrimaryBtn}" Tag="&#xE8A7;" Content="Open in Obsidian" Click="OpenNote_Click" Margin="0,0,8,8"/>
                <Button x:Name="ClaudeButton" Style="{StaticResource Btn}" Tag="&#xE945;" Content="Update with Claude" Click="Claude_Click" Margin="0,0,8,8"
                        Visibility="{Binding IsStale, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource Btn}" Tag="&#xE73E;" Content="Mark up to date" Click="Ack_Click" Margin="0,0,8,8"
                        Visibility="{Binding IsStale, Converter={StaticResource Vis}}"/>
              </WrapPanel>

              <!-- Claude: working -->
              <Border x:Name="ClaudeBusy" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12" Visibility="Collapsed">
                <Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Spinner" Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" RenderTransformOrigin="0.5,0.5">
                      <TextBlock.RenderTransform><RotateTransform x:Name="SpinnerTurn"/></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="ClaudeBusyText" Text="Claude is reading the changes…" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Style="{StaticResource Btn}" Tag="&#xE711;" Content="Cancel" Click="ClaudeCancel_Click" HorizontalAlignment="Right" Padding="10,5"/>
                </Grid>
              </Border>

              <!-- Claude: error -->
              <Border x:Name="ClaudeError" Margin="0,14,0,0" CornerRadius="8" Padding="14,10" Background="#2A1A1C" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource Removed}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                  <TextBlock x:Name="ClaudeErrorText" Foreground="{StaticResource Fg}" TextWrapping="Wrap" MaxWidth="560"/>
                </StackPanel>
              </Border>

              <!-- Claude: proposed note -->
              <StackPanel x:Name="Proposal" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="PROPOSED UPDATE" Style="{StaticResource Label}" Margin="0"/>
                  <TextBlock x:Name="ProposalStats" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}"/>
                </Grid>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="0,6">
                  <ItemsControl x:Name="DiffList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="row" Padding="12,1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="20"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="sign" Text="{Binding Sign}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Faint}"/>
                            <TextBlock x:Name="txt" Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="Added">
                            <Setter TargetName="row" Property="Background" Value="#14271D"/>
                            <Setter TargetName="sign" Property="Foreground" Value="{StaticResource Ok}"/>
                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Fg}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Removed">
                            <Setter TargetName="row" Property="Background" Value="#2A1A1C"/>
                            <Setter TargetName="sign" Property="Foreground" Value="{StaticResource Removed}"/>
                            <Setter TargetName="txt" Property="TextDecorations" Value="Strikethrough"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Gap">
                            <Setter TargetName="txt" Property="Foreground" Value="{StaticResource Faint}"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="ApplyButton" Style="{StaticResource PrimaryBtn}" Tag="&#xE74E;" Content="Save to note" Click="ApplyProposal_Click" Margin="0,0,8,0"/>
                  <Button Style="{StaticResource Btn}" Tag="&#xE711;" Content="Discard" Click="DiscardProposal_Click"/>
                </WrapPanel>
                <TextBlock Text="Saving keeps a backup of the old note in %AppData%\DocsSync\backups." Foreground="{StaticResource Faint}" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>

              <!-- Changed files -->
              <StackPanel Margin="0,22,0,0" Visibility="{Binding HasFiles, Converter={StaticResource Vis}}">
                <TextBlock Text="CHANGED SINCE THIS NOTE WAS UPDATED" Style="{StaticResource Label}"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="4">
                  <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource FileRow}" Click="OpenFile_Click" Tag="{Binding Full}" ToolTip="Open file">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="24"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="g" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Stale}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Rel}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Fg}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Meta}" Foreground="{StaticResource Faint}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                          </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="Added">
                            <Setter TargetName="g" Property="Foreground" Value="{StaticResource Ok}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Removed">
                            <Setter TargetName="g" Property="Foreground" Value="{StaticResource Removed}"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <!-- Functions -->
              <StackPanel Margin="0,22,0,0" Visibility="{Binding HasFuncs, Converter={StaticResource Vis}}">
                <TextBlock Text="FUNCTIONS" Style="{StaticResource Label}"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                  <ItemsControl ItemsSource="{Binding FuncLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,2"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <!-- No match help -->
              <StackPanel Margin="0,22,0,0" Visibility="{Binding IsUnmatched, Converter={StaticResource Vis}}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" MaxWidth="560" HorizontalAlignment="Left" LineHeight="20">
                  No code file name contains this note's title. To link it to code, add a <Run FontFamily="{StaticResource Mono}" Foreground="{StaticResource Fg}">covers</Run> line to the note's frontmatter, with paths relative to the project folder:
                </TextBlock>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                  <Grid>
                    <TextBlock x:Name="Snippet" Text="{Binding CoversSnippet}" FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Fg}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="CopySnippet_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                  </Grid>
                </Border>
                <TextBlock Text="Notes that are only an overview, like a project's hub note, can stay unmatched." Foreground="{StaticResource Faint}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Matching info -->
              <TextBlock Margin="0,28,0,0" Foreground="{StaticResource Faint}" FontSize="12" TextWrapping="Wrap">
                <Run Text="Matched by "/><Run Text="{Binding MatchedBy, Mode=OneWay}" FontFamily="{StaticResource Mono}"/>
              </TextBlock>
            </StackPanel>
          </ScrollViewer>

          <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource Faint}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DetailEmptyText" Text="Select a note to see what changed" Foreground="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Settings -->
    <Border Grid.Row="1" x:Name="SettingsView" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Visibility="Collapsed">
      <DockPanel>
        <!-- footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Panel}" Padding="40,12">
          <Grid MaxWidth="720" HorizontalAlignment="Stretch">
            <TextBlock x:Name="SettingsError" Foreground="{StaticResource Removed}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,220,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource Btn}" Tag="&#xE711;" Content="Cancel" Click="SettingsCancel_Click" Margin="0,0,8,0"/>
              <Button Style="{StaticResource PrimaryBtn}" Tag="&#xE74E;" Content="Save" Click="SettingsSave_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="40,26,40,40" MaxWidth="720" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
              <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Click="SettingsCancel_Click" Margin="-8,0,6,0"/>
              <TextBlock Text="Settings" FontFamily="{StaticResource Display}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Vault -->
            <TextBlock Text="Obsidian vault" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="The folder that holds your notes." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,30">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="VaultBox" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
              <Button Grid.Column="1" Style="{StaticResource Btn}" Tag="&#xE8DA;" Content="Browse" Click="BrowseVault_Click" Margin="8,0,0,0"/>
            </Grid>

            <!-- Projects -->
            <Grid>
              <StackPanel>
                <TextBlock Text="Projects" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Each project pairs a code folder with a folder of notes in the vault." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn}" Tag="&#xE721;" Content="Find projects" Click="AutoDetect_Click" Margin="0,0,8,0" ToolTip="Pick the folder that holds your projects; each subfolder is paired with the vault folder of the same name"/>
                <Button Style="{StaticResource Btn}" Tag="&#xE710;" Content="Add project" Click="AddProject_Click"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="NoProjects" Text="No projects yet. Add one, or use Find projects." Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed"/>
            <ItemsControl x:Name="ProjectList" Margin="0,4,0,30">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="Name" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                      <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove project" Click="RemoveProject_Click" Tag="{Binding}" Margin="8,0,0,8"/>

                      <TextBlock Grid.Row="1" Text="Code folder" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Root, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="12.5" Margin="0,0,0,8"/>
                      <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8DA;" ToolTip="Browse" Click="BrowseRoot_Click" Tag="{Binding}" Margin="8,0,0,8"/>

                      <TextBlock Grid.Row="2" Text="Notes folder" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VaultFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="12.5" Margin="0,0,0,8"/>
                      <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8DA;" ToolTip="Pick a folder inside the vault" Click="BrowseNotes_Click" Tag="{Binding}" Margin="8,0,0,8"/>

                      <TextBlock Grid.Row="3" Text="Watch" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Sources, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" FontSize="12.5" ToolTip="Folders inside the code folder to watch, comma-separated. Use . for all."/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Claude -->
            <TextBlock Text="Claude" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12">
              Used by Update with Claude. Create an API key at <Run FontFamily="{StaticResource Mono}" Foreground="{StaticResource Fg}">console.anthropic.com</Run>. It's stored encrypted for your Windows account.
            </TextBlock>
            <Border Style="{StaticResource Card}" Margin="0,0,0,30">
              <StackPanel>
                <TextBlock Text="API key" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="KeyBox" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                  <Button x:Name="ForgetKeyButton" Grid.Column="1" Style="{StaticResource Btn}" Tag="&#xE74D;" Content="Remove" Click="ForgetKey_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,18"/>

                <TextBlock Text="Model" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource Bg}" CornerRadius="7" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModelOpus" Style="{StaticResource Seg}" GroupName="model">Opus 5.5</RadioButton>
                    <RadioButton x:Name="ModelSonnet" Style="{StaticResource Seg}" GroupName="model">Sonnet 5.5</RadioButton>
                    <RadioButton x:Name="ModelHaiku" Style="{StaticResource Seg}" GroupName="model">Haiku 5.5</RadioButton>
                  </StackPanel>
                </Border>
                <TextBlock Text="Opus writes the best docs. Sonnet and Haiku are cheaper and faster." Style="{StaticResource Hint}" Margin="0,0,0,18"/>

                <TextBlock Text="Effort" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource Bg}" CornerRadius="7" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="EffortLow" Style="{StaticResource Seg}" GroupName="effort">Low</RadioButton>
                    <RadioButton x:Name="EffortMedium" Style="{StaticResource Seg}" GroupName="effort">Medium</RadioButton>
                    <RadioButton x:Name="EffortHigh" Style="{StaticResource Seg}" GroupName="effort">High</RadioButton>
                  </StackPanel>
                </Border>
                <TextBlock Text="Higher effort reads the code more carefully. It takes longer and costs more." Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>

            <!-- Prompt template -->
            <Grid>
              <StackPanel>
                <TextBlock Text="Prompt template" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Shown when there's no API key, so you can paste it into Claude Code or claude.ai yourself. Words in braces are filled in for the note you picked." Style="{StaticResource Hint}" Margin="0,0,180,10"/>
              </StackPanel>
              <Button Style="{StaticResource Btn}" Tag="&#xE777;" Content="Reset" Click="ResetTemplate_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Restore the default template"/>
            </Grid>
            <Border Background="{StaticResource Bg}" CornerRadius="7" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TplOne" Style="{StaticResource Seg}" GroupName="tpl" IsChecked="True" Checked="TemplateTab_Changed">One note</RadioButton>
                <RadioButton x:Name="TplAll" Style="{StaticResource Seg}" GroupName="tpl" Checked="TemplateTab_Changed">Update all</RadioButton>
              </StackPanel>
            </Border>
            <TextBox x:Name="TemplateBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" Height="230" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="8,8"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,30" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Faint}">
              <Run x:Name="TokensText"/><LineBreak/><Run FontFamily="{StaticResource Ui}" Text="{}{code} and {note_text} paste in file contents, for chats that can't open files."/>
            </TextBlock>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}" Padding="18,6">
              <StackPanel>
                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Margin="0,10">
                  <StackPanel>
                    <TextBlock Text="Start with Windows"/>
                    <TextBlock Text="Opens quietly in the tray when you sign in." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Rectangle Height="1" Fill="{StaticResource Line}"/>
                <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Margin="0,10">
                  <StackPanel>
                    <TextBlock Text="Notifications"/>
                    <TextBlock Text="Pop up a message when a note stops matching its code." Style="{StaticResource Hint}"/>
                  </StackPanel>
                </CheckBox>
                <Rectangle Height="1" Fill="{StaticResource Line}"/>
                <StackPanel Margin="0,10">
                  <TextBlock Text="Extra file types"/>
                  <TextBlock Text="Lua, Luau, C#, Java, Kotlin, Python, JS/TS, Go, Rust, C/C++, Swift, Ruby, PHP, Dart and GDScript are built in. Add others here, like .shader, .glsl" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                  <TextBox x:Name="FileTypesBox" FontFamily="{StaticResource Mono}" FontSize="12.5"/>
                </StackPanel>
                <Rectangle Height="1" Fill="{StaticResource Line}"/>
                <Grid Margin="0,10">
                  <StackPanel>
                    <TextBlock Text="Data folder"/>
                    <TextBlock Text="Settings, tracking state and note backups." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Button Style="{StaticResource Btn}" Tag="&#xE8B7;" Content="Open" Click="OpenDataFolder_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- No-API-key prompt popup -->
    <Grid x:Name="PromptPopup" Grid.RowSpan="2" Visibility="Collapsed" KeyDown="PromptPopup_KeyDown">
      <Border Background="#B3070809" MouseDown="ClosePrompt_Click"/>
      <Border Style="{StaticResource Card}" Background="{StaticResource Raised}" Padding="24,22" MaxWidth="680" Margin="40,56,40,40"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
              <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Hover}">
                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Text="Copy this prompt into Claude" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close" Click="ClosePrompt_Click" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock x:Name="PromptHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="CopyPromptButton" Style="{StaticResource PrimaryBtn}" Tag="&#xE8C8;" Content="Copy prompt" Click="CopyPrompt_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn}" Tag="&#xE713;" Content="Add an API key" Click="PromptSettings_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource Btn}" Tag="&#xE70F;" Content="Edit template" Click="PromptSettings_Click"/>
          </StackPanel>
          <TextBox x:Name="PromptText" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                   FontFamily="{StaticResource Mono}" FontSize="12.5" Padding="10,10" MaxHeight="340"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
