<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Per-user install into %LocalAppData%\Programs\Docs Sync: no admin prompt. -->
  <Package Name="Docs Sync"
           Manufacturer="lummasharp"
           Version="$(Version)"
           UpgradeCode="edd28ab1-8b7b-47f1-b73d-ea53ceba0ca4"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Docs Sync is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\assets\DocsSync.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lummasharp/docs-sync" />

    <!-- The app hides to the tray on close, so stop it outright before files are replaced or removed. -->
    <util:CloseApplication Id="StopDocsSync" Target="DocsSync.exe" TerminateProcess="1" RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Docs Sync" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main">
      <Component Id="App" Directory="INSTALLFOLDER" Guid="93995b3b-dd9e-4c94-ab24-9a16f7ad91a4">
        <File Source="$(PublishDir)DocsSync.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\DocsSync" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>

      <Component Id="StartMenu" Directory="ProgramMenuFolder">
        <Shortcut Id="AppShortcut" Name="Docs Sync" Description="Keep Obsidian notes in sync with your code"
                  Target="[INSTALLFOLDER]DocsSync.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\DocsSync" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Start with Windows (can be switched off in Settings); removed on uninstall. -->
      <Component Id="Autostart" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="DocsSync" Type="string"
                       Value="&quot;[INSTALLFOLDER]DocsSync.exe&quot; --tray" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Open the app once installation finishes. -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]DocsSync.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
